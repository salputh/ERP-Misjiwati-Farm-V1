APP_NAME="ERP Misjiwati Farm - DEMO"
APP_ENV=demo
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo.misjiwatifarm.tech

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

# Log level warning untuk demo
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null

# Database demo (SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/erp-misjiwati-demo/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Email demo mode (log only)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@misjiwatifarm.tech"
MAIL_FROM_NAME="${APP_NAME}"

# JANGAN ISI - Demo tidak butuh API keys eksternal
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=

VITE_APP_NAME="${APP_NAME}"

# Demo mode configuration
DEMO_MODE=true
DEMO_USERNAME=demo@misjiwatifarm.tech
DEMO_PASSWORD=DemoMisjiwati2026
DEMO_READONLY=false

# Contoh konfigurasi produksi. Salin ke .env di server, lalu isi nilai yang kosong.
# Jangan pernah meng-commit .env yang sudah berisi nilai rahasia.

APP_NAME="ERP Misjiwati Farm"
APP_ENV=production
# Isi dengan: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.contoh-domain.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log harian (disimpan 14 hari), hanya peringatan ke atas.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# Database SQLite di luar folder aplikasi dan di luar public/.
DB_CONNECTION=sqlite
DB_DATABASE=/var/lib/erp-misjiwati/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@contoh-domain.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

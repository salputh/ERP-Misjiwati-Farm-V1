# Nginx untuk ERP Misjiwati Farm.
# Salin ke /etc/nginx/sites-available/erp-misjiwati, ganti erp.contoh-domain.id dan versi PHP,
# lalu: ln -s /etc/nginx/sites-available/erp-misjiwati /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
# Sertifikat dibuat dengan certbot (lihat DEPLOY.md).

# HTTP hanya untuk validasi Let's Encrypt dan pengalihan ke HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name erp.contoh-domain.id;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name erp.contoh-domain.id;

    # Hanya folder public yang dapat diakses dari web.
    root /var/www/erp-misjiwati/public;
    index index.php;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/erp.contoh-domain.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/erp.contoh-domain.id/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size 20m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    access_log /var/log/nginx/erp-misjiwati.access.log;
    error_log  /var/log/nginx/erp-misjiwati.error.log warn;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Tolak semua file dan folder tersembunyi (.env, .git, .htaccess, dll.), kecuali .well-known.
    location ~ /\.(?!well-known).* {
        deny all;
        return 404;
    }

    # Tolak file yang tidak seharusnya disajikan meskipun tidak sengaja masuk ke public/.
    location ~* \.(sqlite|sqlite3|db|sql|log|sh|bak|env|ini|lock)$ {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Aset hasil build Vite punya hash di nama file, aman disimpan lama di browser.
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(?:css|js|png|jpg|jpeg|gif|svg|ico|woff2?|ttf)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    # Hanya index.php yang dieksekusi; file .php lain di public/ tidak dijalankan.
    location = /index.php {
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 120;
    }

    location ~ \.php$ {
        return 404;
    }
}
